# 复制为 deploy/vps/.env（chmod 600），不进 git。
# 服务端与 worker 的共享令牌：openssl rand -hex 32（Mac 上 ~/.config/claude-bridge/worker.env 填同一个）
CLAUDE_BRIDGE_AGENT_TOKEN=
# 会话签名密钥（可不填：不填时自动生成并存进数据库，重启不掉登录）
CLAUDE_BRIDGE_SECRET=
# 经 Caddy https 反代，cookie 走 Secure
CLAUDE_BRIDGE_COOKIE_SECURE=1
# 配额提示里重置时间用的时区
CLAUDE_BRIDGE_TZ=Asia/Tokyo
