# 复制为仓库根目录的 .env（chmod 600），不进 git。worker 由 deploy/mac/run-worker.sh 读取。
CLAUDE_BRIDGE_URL=https://claude.szyyw.xyz
# 与 VPS 上 /opt/claude-bridge/deploy/vps/.env 的同名变量一致
CLAUDE_BRIDGE_AGENT_TOKEN=
# claude 的工作目录：所有用户共用，别指向放私人文件的地方
CLAUDE_BRIDGE_CWD=/Users/szyyw/claude-bridge-work
# 可选：CLAUDE_BRIDGE_ALLOWED_TOOLS="Read,Glob,Grep,WebSearch,WebFetch"
